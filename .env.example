NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trust_center
DB_USER=trust_center
DB_PASSWORD=change_me

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=24h

OAUTH_CLIENT_ID=change_me
OAUTH_CLIENT_SECRET=change_me
OAUTH_REDIRECT_URI=http://localhost:3001/oauth/callback
OAUTH_AUTHORIZATION_URL=https://account.example.com/oauth/authorize
OAUTH_USERINFO_URL=https://accountapi.example.com/api/oauth2/userinfo

# External API keys. Use strong random values and rotate regularly.
API_KEYS=change_me_api_key_1,change_me_api_key_2

# Group robot webhooks (optional). Leave empty to disable.
# Never commit real webhook URLs or keys.
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
# Comma-separated extra webhooks; provider is inferred from the URL host.
NOTIFY_WEBHOOK_URLS=

# KYC notification layout: WeCom card | markdown | text; Feishu card | text.
WECOM_NOTIFY_FORMAT=card
FEISHU_NOTIFY_FORMAT=card
# Public origin used for notification links and the E-era logo.
NOTIFY_PUBLIC_BASE_URL=https://trust.emoera.com
